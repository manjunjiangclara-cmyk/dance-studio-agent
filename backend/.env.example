# Local synthetic demo only. These match compose.yaml and are not production credentials.
DATABASE_URL=postgresql+psycopg://copilot:copilot_local@127.0.0.1:5433/studio_copilot
TEST_DATABASE_URL=postgresql+psycopg://copilot:copilot_local@127.0.0.1:5433/studio_copilot_test

# Local demo credential used by Swagger's Authorize button and API requests.
ADMIN_API_TOKEN=local-demo-admin-token

# Agent only: set real values in ignored .env or export them. Never commit a real key.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# STUDIO_POLICY_PATH=policies/studio.yaml

# Public portfolio works without Google configuration. These enable the owner workspace.
# Use the exact origin seen in the browser; shared hosting requires HTTPS.
PUBLIC_BASE_URL=http://localhost:8000
# OWNER_EMAIL=your-google-email@example.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SESSION_SECRET=  # At least 32 random characters; keep it stable and private.
# WEBSITE_DIST=  # Optional absolute directory containing the compiled frontend.
