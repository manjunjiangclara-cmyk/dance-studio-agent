    },
    {
      "id": "ab636798-e48d-53ad-ad28-6d6a67e308dc",
      "created_at": "2027-02-07T00:00:00Z",
      "updated_at": "2027-02-07T00:00:00Z",
      "conversation_id": "f6574588-1747-5532-99aa-9adedffd94ad",
      "kind": "assistant_draft",
      "body": "Hi Jules, wear comfortable clothes you can move in, such as leggings and a fitted T-shirt. Socks are suitable for your first class; ballet shoes are optional.",
      "occurred_at": "2027-02-07T10:06:00+11:00",
      "review_managed": true
    },
    {
      "id": "e7006165-a655-507c-815c-2ead33050f7f",
